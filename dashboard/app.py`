# 5. The Shame Analytics (Monochromatic Donut)
st.markdown('<div class="burn-card-label" style="text-align:center; margin-bottom:1rem;">Spending Breakdown</div>', unsafe_allow_html=True)

if m["txs"] and any(t["direction"] == "debit" for t in m["txs"]):
    df_tx = pd.DataFrame(m["txs"])
    debits = df_tx[df_tx["direction"] == "debit"]
    cat_sums = debits.groupby("category")["amount"].sum().sort_values(ascending=False)

    if not cat_sums.empty:
        colors = ["#6366F1"] + ["#333333", "#444444", "#555555", "#666666", "#777777", "#888888"]
        colors = colors[:len(cat_sums)]

        fig = go.Figure(data=[go.Pie(
            labels=cat_sums.index,
            values=cat_sums.values,
            hole=0.7,
            marker=dict(colors=colors, line=dict(color="#000000", width=2))
        )])

        fig.update_layout(
            paper_bgcolor="rgba(0,0,0,0)",
            plot_bgcolor="rgba(0,0,0,0)",
            showlegend=True,
            legend=dict(font=dict(color="#666666"), bgcolor="rgba(0,0,0,0)"),
            margin=dict(l=20, r=20, t=20, b=20),
            height=300,
            width=400
        )
        st.plotly_chart(fig, use_container_width=False)
    else:
        st.info("No spending data to analyze this month.")
else:
    st.info("No spending data to analyze this month.")

# 6. The Bank-Grade Ledger
st.markdown('<div class="ledger-container">', unsafe_allow_html=True)
st.markdown('<div class="burn-card-label" style="margin-bottom:1rem;">Transaction History</div>', unsafe_allow_html=True)

if not m["txs"]:
    st.info("No entries this month.")
else:
    sorted_txs = sorted(m["txs"], key=lambda x: x["date"], reverse=True)

    # To keep the UI "Slapping", we use columns for each row to include a category selector
    for tx in sorted_txs:
        amt_class = "amount-credit" if tx["direction"] == "credit" else "amount-debit"
        sign = "+" if tx["direction"] == "credit" else "-"

        tx_date = tx['date']
        if isinstance(tx_date, str):
            try:
                from datetime import datetime
                tx_date_obj = datetime.strptime(tx_date, "%Y-%m-%d").date()
                tx_date_str = tx_date_obj.strftime('%d %b')
            except ValueError:
                tx_date_str = str(tx_date)
        elif tx_date:
            tx_date_str = tx_date.strftime('%d %b')
        else:
            tx_date_str = "N/A"

        # Use columns to put the category selector at the end of the row
        col_tx, col_cat = st.columns([0.85, 0.15])
        with col_tx:
            st.markdown(
                f"""
                <div class="ledger-row" style="border-bottom:none; padding: 0;">
                    <div style="display:flex; align-items:center;">
                        <div class="ledger-merchant">{tx['merchant']}</div>
                        <div class="ledger-date">{tx_date_str}</div>
                    </div>
                    <div class="ledger-amount {amt_class}">{sign}{inr(tx['amount'])}</div>
                </div>
                """, unsafe_allow_html=True
            )
        with col_cat:
            # Category dropdown for each transaction
            new_cat = st.selectbox(
                "Cat",
                options=db.CATEGORIES,
                index=db.CATEGORIES.index(tx['category']) if tx['category'] in db.CATEGORIES else -1,
                key=f"cat_{tx['id']}",
                label_visibility="collapsed"
            )
            if new_cat != tx['category']:
                db.update_category(tx['id'], new_cat)
                st.rerun()

st.markdown('</div>', unsafe_allow_html=True)

