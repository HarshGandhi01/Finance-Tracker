def inr(x: float) -> str:
    """Format as Indian Rupee."""
    return f"₹{x:,.2f}"

# ---------------------------------------------------------------- data
m = db.compute_metrics(month, today, TARGET_DAILY)

# Death Clock Calculation
daily_avg = m.get("daily_avg", 0.0)
safe_spend = m.get("safe_to_spend", 0.0)
divisor = max(daily_avg, TARGET_DAILY)
days_left = safe_spend / divisor if divisor > 0 else 999

# ---------------------------------------------------------------- UI
# 1. The Death Clock Hero
clock_class = "death-clock-danger" if days_left <= 7 else ""
st.markdown(
    f"""
    <div class="death-clock-container">
        <div class="death-clock-label">Days Until Broke</div>
        <div class="death-clock-value {clock_class}">{int(days_left)}</div>
    </div>
    """, unsafe_allow_html=True
)

# 2. Food Status (The New Feature - Design Fixed)
food_remaining = m.get("food_remaining_today", 0.0)
val_class = "food-danger" if food_remaining < 0 else ""
if food_remaining >= 0:
    status_text = f"You have {inr(food_remaining)} left for food today." if food_remaining > 0 else "Food budget hit. Eat the mess food."
elif food_remaining < 0:
    status_text = f"Overspent on food by {inr(abs(food_remaining))}. You're officially cooked."

st.markdown(
    f"""
    <div class="food-status-card">
        <div class="food-status-label">Today's Food Status</div>
        <div class="food-status-value {val_class}">{inr(food_remaining)}</div>
        <div class="food-status-subtext">{status_text}</div>
